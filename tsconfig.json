{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,      // 兼容 CommonJS 模块
    "skipLibCheck": true,         // 跳过第三方库类型检查（可选）
    "types": ["node"]             // 显式声明 Node 类型
  },
  "exclude": ["node_modules", ".vscode-test"]
}